# Copier en apps/client/.env.local et adapter (jamais commité).
# Jeu en ligne : projet Supabase (Tableau de bord → Project Settings → API).
# La clé « anon » est publique par nature : elle ne donne accès qu'au temps réel.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Adresse publique du jeu web (liens d'invitation envoyés depuis l'appli mobile).
VITE_PUBLIC_URL=https://akrambrl.github.io/Jeu-ville/
# Développement sans Supabase : jeu en ligne entre onglets d'un même navigateur.
# VITE_ONLINE=local
