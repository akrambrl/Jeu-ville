{
  "name": "@jeu-ville/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@colyseus/core": "~0.16.26",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "~0.16.5",
    "@fastify/cors": "^11.1.0",
    "@jeu-ville/shared": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "fastify": "^5.6.1",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6"
  }
}
