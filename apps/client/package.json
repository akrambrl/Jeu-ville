{
  "name": "@jeu-ville/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "build:demo": "vite build -c vite.demo.config.ts && node scripts/bundle-demo.mjs",
    "build:app": "vite build && cap sync",
    "app:icons": "capacitor-assets generate --android --ios --iconBackgroundColor \"#241656\" --splashBackgroundColor \"#241656\""
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@jeu-ville/shared": "workspace:*",
    "colyseus.js": "~0.16.22"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "vite": "^7.3.7"
  }
}
